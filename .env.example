# ===================== 数据库（必填） =====================
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/clinicalagent

# ===================== LLM（走 MODEL_PROFILES 多厂商前缀匹配） =====================
# 主模型 + 备用模型（逗号分隔），模型名前缀自动匹配下方对应厂商密钥
LLM_MODEL_ID=deepseek-v4-flash
LLM_FALLBACK_MODELS=deepseek-v4-pro
LLM_TIMEOUT=60

# --- 各厂商密钥 / 接口地址（用哪个厂商填哪个，按前缀自动读取） ---
DEEPSEEK_API_KEY=your_deepseek_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
OPENAI_API_KEY=your_openai_key_here
GLM_API_KEY=your_glm_key_here
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GOOGLE_API_KEY=your_gemini_key_here
GOOGLE_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
QWEN_API_KEY=your_qwen_key_here
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
MOONSHOT_API_KEY=your_moonshot_key_here
MOONSHOT_BASE_URL=https://api.moonshot.cn/v1
MINIMAX_API_KEY=your_minimax_key_here
MINIMAX_BASE_URL=https://api.minimax.chat/v1
ANTHROPIC_API_KEY=your_anthropic_key_here
CLAUDE_OPEN_API_KEY=your_claude_open_key_here
CLAUDE_OPEN_BASE_URL=your_claude_open_base_url
OLLAMA_API_KEY=ollama
OLLAMA_BASE_URL=http://localhost:11434/v1
PROXY_API_KEY=your_proxy_key_here
PROXY_BASE_URL=your_proxy_base_url/v1

# ===================== LangSmith 追踪（两版共用） =====================
LANGSMITH_API_KEY=your_langsmith_key_here
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=medicine-pro

# ===================== HuggingFace 缓存目录（推理时模型加载路径，留空用默认 ~/.cache/huggingface） =====================
HF_HOME=

# ===================== 嵌入 / 精排 =====================
EMBEDDING_MODEL=NeuML/pubmedbert-base-embeddings
EMBEDDING_DIMENSION=768
RERANK_MODEL=BAAI/bge-reranker-base

# ===================== 专家版本地微调模型（Llama-3.2-3B + LoRA，reasoning 节点用） =====================
REASONING_MODEL_BASE_MODEL=unsloth/llama-3.2-3b-instruct
REASONING_MODEL_ADAPTER_PATH=expert_finetuning/medical_lora_adapter

# ===================== PubMed（专家版） =====================
NCBI_API_KEY=your_ncbi_key_here
PUBMED_MAX_RESULTS=100
PUBMED_BATCH_SIZE=20

# ===================== 切块（两版共用） =====================
CHUNK_SIZE=512
CHUNK_OVERLAP=50

# ===================== 检索（患者版；专家版用模块常量 FINAL_TOP_K，两版独立） =====================
RETRIEVAL_TOP_K=5

# ===================== 患者版分诊分类器（LoRA） =====================
TRIAGE_BASE_MODEL=distilbert-base-uncased
TRIAGE_ADAPTER_PATH=patient_finetuning/artifacts/triage-lora

# ===================== API 服务（两版共用入口 /api/chat） =====================
APP_API_KEY=your_app_api_key_here
CORS_ORIGINS=http://localhost:3000
RATE_LIMIT_PER_MINUTE=30
